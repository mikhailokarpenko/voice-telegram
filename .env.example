ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://voice.bashpwnz.com
# Required in production (startup fails if unset). Use a strong, unique value.
ADMIN_PASSWORD=
# Required in production; >=32 chars and stable across restarts/replicas.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_JWT_SECRET=
DATABASE_URL=postgresql+asyncpg://voice_telegram:voice_telegram_password@postgres:5432/voice_telegram
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
LITELLM_REALTIME_MODEL=litellm/realtime-xai
OPENAI_VOICE=marin
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CODE=
MAX_CALL_SECONDS=1800
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=500
